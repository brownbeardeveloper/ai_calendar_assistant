$primary: #4a90e2;
$primary-darken-1: #3a6fb3;
$surface: #1e1e1e;
$surface-darken-1: #171717;
$panel: #2a2a2a;
$text: #ffffff;
$warning: #ffcc00;
$error: #ff4444;

#chat-section,
#calendar-section {
    width: 1fr;
    height: 100%;
}

.column {
    padding: 1 1;
    height: 100%;
}

#chat-container {
    height: 1fr;
    overflow-y: auto;
    padding: 1 1;
    border: heavy $primary;
    border-bottom: none;
}

#chat-input {
    height: 3;
    margin: 0 1;
    border: heavy $primary;
}

CalendarDisplay {
    height: auto;
    border: heavy $primary;
    margin: 0 0 1 0;
}

EventList {
    height: 1fr;
    border: heavy $primary;
    overflow: auto;
    padding-bottom: 1;
}

ListView {
    background: $surface;
    color: $text;
    overflow: auto;
    height: 100%;
    border: none;
    padding: 1 1;
    margin: 1 1;
}

ListItem {
    padding: 1 1;
    background: $panel;
    color: $text;
    margin-bottom: 1;
    border: heavy $primary-darken-1;
}

.event-item {
    margin: 1 1;
    padding: 0;
    background: $surface;
}

.no-events {
    text-align: center;
    text-style: bold;
    color: $error;
    margin: 2 2;
    padding: 2 2;
}

#loading-message {
    color: $warning;
    background: $surface;
    margin: 1 1;
    padding: 1 1;
    text-align: center;
}

.error {
    color: $error;
    background: $surface-darken-1;
    margin: 1 1;
    padding: 1 1;
    text-align: center;
    border: heavy $error;
}

.spacer {
    height: 1;
}

.message {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
}

.align-right {
    content-align: right middle;
}

.align-left {
    content-align: left middle;
}